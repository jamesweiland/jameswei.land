---
type Props = { date: Date };

const { date } = Astro.props;
console.log(date)
console.log(typeof date)

---

{date && 
(<time datetime={date.toISOString()}>
    {
        date.toLocaleDateString('en-us', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
        })
    }
</time>)

}
